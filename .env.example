# Copia este archivo como .env (desarrollo) o .env.production (build para el servidor) y ajusta los valores.
# Los archivos .env no se suben a git; solo este ejemplo.

# URL de la API de Laravel, con /api al final. De aquí salen también /sitemap.xml y /share del backend.
# En local tiene que ser localhost (no Valet/https): Sanctum espera el front en localhost:5173
VITE_API_BASE_URL="http://localhost:8000/api"
